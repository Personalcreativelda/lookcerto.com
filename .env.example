
# lookcerto.com - Configuração de Ambiente

# API Key do Gemini (Obter em ai.google.dev)
API_KEY=sua_chave_aqui

# Banco de Dados
DATABASE_URL=postgresql://user:password@localhost:5432/lookcerto

# Autenticação (JWT)
JWT_SECRET=mude_isso_para_algo_muito_seguro

# Configurações de Storage (MinIO / S3)
# Para MinIO, use seu endpoint (ex: http://192.168.1.100:9000)
S3_ENDPOINT=http://seu-servidor-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=seu_access_key
S3_SECRET_KEY=seu_secret_key
S3_BUCKET_NAME=lookcerto-creations
S3_FORCE_PATH_STYLE=true

# Pagamentos (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
